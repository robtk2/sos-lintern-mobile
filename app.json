{
  "expo": {
    "name": "SOS Lintern",
    "slug": "sos-lintern",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.robk2.x02soslintern"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SOS Lintern to use the camera flashlight for emergency signals."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow SOS Lintern to use your location for emergency rescue coordinates.",
          "locationWhenInUsePermission": "Allow SOS Lintern to use your location for emergency rescue coordinates."
        }
      ]
    ]
  }
}
